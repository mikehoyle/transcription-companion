{
  "name": "transcription-companion",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "headers": "node scripts/gen-headers.mjs",
    "predev": "node scripts/copy-ffmpeg.mjs",
    "prebuild": "node scripts/copy-ffmpeg.mjs && node scripts/gen-headers.mjs",
    "postbuild": "node scripts/check-asset-sizes.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "signalsmith-stretch": "^1.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12"
  }
}
